{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsb.local/schemas/evaluation_result_bundle.schema.json",
  "title": "TSB structured evaluation result bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "workspace_sha256",
    "evaluator_version",
    "evaluated_at",
    "functional_tests",
    "architecture_checks",
    "operational_evidence",
    "docker_status",
    "docker_logs",
    "database_checks",
    "evaluation_error"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^L[1-4]-[0-9]{2}$"},
    "workspace_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluator_version": {"type": "string", "minLength": 1},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "functional_tests": {
      "type": "array",
      "items": {"$ref": "#/$defs/checkResult"}
    },
    "architecture_checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/checkResult"}
    },
    "operational_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/operationalResult"}
    },
    "docker_status": {"type": "string"},
    "docker_logs": {"type": "string"},
    "database_checks": {"type": "object"},
    "evaluation_error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "detail"],
          "properties": {
            "classification": {
              "enum": ["evaluator_error", "infrastructure_failure"]
            },
            "detail": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  },
  "$defs": {
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "applicable",
        "passed",
        "duration_seconds",
        "detail",
        "evidence"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "applicable": {"type": "boolean"},
        "passed": {"type": ["boolean", "null"]},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "detail": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "operationalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "detail", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "status": {
          "enum": ["passed", "failed", "not_applicable", "unavailable"]
        },
        "detail": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
