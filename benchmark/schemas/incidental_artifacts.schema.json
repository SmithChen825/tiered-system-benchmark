{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsb.local/schemas/incidental_artifacts.schema.json",
  "title": "TSB incidental workspace artifact inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "policy_id",
    "policy_sha256",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"enum": ["not_scanned", "completed"]},
    "policy_id": {"const": "tsb-incidental-workspace-artifacts-v1"},
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "classification", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "classification": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
