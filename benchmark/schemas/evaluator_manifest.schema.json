{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsb.local/schemas/evaluator_manifest.schema.json",
  "title": "TSB task evaluator manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "review_status",
    "pytest_environment_variable",
    "functional_tests",
    "architecture_checks",
    "operational_evidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "pattern": "^L[1-4]-[0-9]{2}$"},
    "review_status": {"enum": ["draft", "approved"]},
    "pytest_environment_variable": {"type": ["string", "null"]},
    "functional_tests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evaluatorItem"}
    },
    "architecture_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/architectureItem"}
    },
    "operational_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evaluatorItem"}
    }
  },
  "$defs": {
    "status": {
      "enum": ["implemented", "pending_implementation"]
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "evaluatorItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "runner", "source", "implementation_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "description": {"type": "string", "minLength": 1},
        "runner": {"enum": ["pytest", "node", "compose_probe", "global_validator"]},
        "source": {"type": "string", "minLength": 1},
        "implementation_status": {"$ref": "#/$defs/status"}
      }
    },
    "architectureItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement",
        "evidence",
        "implementation_status"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "requirement": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceReference"}
        },
        "implementation_status": {"$ref": "#/$defs/status"}
      }
    }
  }
}
